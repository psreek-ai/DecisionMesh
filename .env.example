# DecisionMesh Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# REQUIRED
# ============================================================

# Your Anthropic API key (get one at https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================
# OPTIONAL — Web Monitoring
# ============================================================

# Tavily API key for web search (only used if web_monitoring_enabled=True per decision)
# Get one at https://app.tavily.com
TAVILY_API_KEY=tvly-your-key-here

# ============================================================
# DATABASE (defaults to local SQLite — no setup required)
# ============================================================

# SQLite (default — zero infrastructure)
DATABASE_URL=sqlite+aiosqlite:///./decisionmesh.db

# PostgreSQL + pgvector (optional, for production use)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/decisionmesh

# ============================================================
# AGENT BEHAVIOR
# ============================================================

DEFAULT_MODEL=claude-3-7-sonnet-20250219
MAX_AGENT_ITERATIONS=10
CAUSAL_THINKING_BUDGET=8000
DIVERGENCE_ALERT_THRESHOLD=0.3
DIVERGENCE_CRITICAL_THRESHOLD=0.7

# ============================================================
# SCHEDULER
# ============================================================

DEFAULT_REVIEW_INTERVAL_DAYS=30
SCHEDULER_TIMEZONE=UTC

# ============================================================
# PRIVACY
# ============================================================

# Local embedding model — never calls any external API
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Set to true to globally disable ALL web monitoring (overrides per-decision settings)
DISABLE_ALL_WEB_MONITORING=false
